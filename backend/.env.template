# Application Environment
NODE_ENV=production
LOG_LEVEL=info

# Server Configuration
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,https://app.loadyar.pk

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=loadyar
DB_PASSWORD=your_secure_password_here
DB_NAME=loadyar
DB_SSL=false

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=30m
BCRYPT_ROUNDS=10

# Session Management
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@loadyar.pk
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@loadyar.pk

# SMS Configuration (Optional)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=LOADYAR

# AWS S3 (Optional - for file storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=loadyar-files

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Sentry Error Tracking (Optional)
SENTRY_DSN=

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOG=true
ENABLE_SOFT_DELETE=true

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * * (daily at 2 AM)
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups

# pgAdmin (Database Management UI)
PGADMIN_EMAIL=admin@loadyar.local
PGADMIN_PASSWORD=your_pgadmin_password

# Stripe/Payment (Optional)
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Twilio (Optional - for SMS/Voice)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
