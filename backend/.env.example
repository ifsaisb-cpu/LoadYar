# LoadYar API Configuration

# Environment
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=loadyar
DB_PASSWORD=loadyar
DB_NAME=loadyar_db
DB_LOGGING=false

# JWT
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Optional: Third-party Services
SENTRY_DSN=
GEMINI_API_KEY=

# Session
SESSION_TIMEOUT_MINUTES=30
